# ---------------------------------------------------------------------------
# Model provider — Groq, free tier.
#
#   GROQ_API_KEY      primary. This is all you need. console.groq.com/keys
#   GROQ_API_KEY_2    optional second account, used when key 1 is rate-limited
#
# Why this provider: the free tier allows 1,000 requests/day with no card,
# confirmed from the live x-ratelimit headers. That is 20x OpenRouter's 50/day
# free cap, which a single 20-question verification sweep exhausts — the cap,
# not the app, is what makes a live demo fragile.
#
# Why a chain: the allowance is counted per account, so one exhausted key should
# cost a round trip rather than the whole answer.
#
# Groq is OpenAI-compatible only. app/agent.py speaks to
# /openai/v1/chat/completions directly over HTTP rather than through an SDK, and
# translates Anthropic-shaped tool_use/tool_result blocks at that one boundary.
# ---------------------------------------------------------------------------

GROQ_API_KEY=
GROQ_API_KEY_2=

# Primary model. VERIFIED to return finish_reason="tool_calls" with a correct
# arguments object, which is what the whole app depends on.
#
# ⚠️  llama-3.3-70b-versatile is NOT available on the free key — it returns
#     model_not_found, despite being the usual recommendation.
GROQ_MODEL=openai/gpt-oss-120b

# Tried in order when the primary keeps failing. Comma-separated, order matters.
# These are the chat models this key actually has; the prompt-guard and whisper
# entries are excluded because they cannot answer questions.
# GROQ_FALLBACK_MODELS=qwen/qwen3.8-27b,openai/gpt-oss-20b

# Response budget per round. Groq's free tier also caps tokens per minute, and
# the system prompt plus 15 tool schemas is re-sent every round, so a very high
# value can hit the TPM ceiling mid-demo.
GROQ_MAX_TOKENS=1024

# Browser origins allowed to call POST /ask. Comma-separated, added to the
# built-in localhost defaults. Set this when the frontend is deployed to its own
# domain, or a browser will block the stream with a bare "Failed to fetch" that
# looks like a dead server.
# CORS_ALLOW_ORIGINS=https://your-frontend.example.com

# 1 = answer from mock/trail.json and never touch the graph.
# 0 = call the agent, which calls app/graph.py.
# GET /health returns {"mock": true|false} — check it before you trust a demo.
USE_MOCK=0

# ---------------------------------------------------------------------------
# FalkorDB
#
# FALKORDB_SSL defaults off. FalkorDB Cloud's instance port answers PLAINTEXT
# Redis despite the console implying TLS, so setting this true makes the driver
# open a handshake the server never answers and the connection HANGS rather than
# erroring — which looks like a slow network, not a config mistake.
# ---------------------------------------------------------------------------
FALKORDB_HOST=localhost
FALKORDB_PORT=6379
FALKORDB_USERNAME=
FALKORDB_PASSWORD=
FALKORDB_SSL=false

# ---------------------------------------------------------------------------
# GitHub sync (new SaaS feature)
#
# The runtime needs these values in .env or in your deployment secret store.
#   GITHUB_OWNER  GitHub owner or organisation (for example BhushanVidhate-27)
#   GITHUB_REPO   GitHub repository (for example graph-hacks-company-brain)
#   GITHUB_TOKEN  GitHub personal access token with `repo` scope. Press `Generate
#                 a token` at github.com/settings/tokens and re-run the sync.
#
# /api/repo/settings validates the config.
# /api/repo/issues and /api/repo/pulls return open issues/pulls.
# /api/repo/items returns both.
GITHUB_OWNER=
GITHUB_REPO=
GITHUB_TOKEN=

FALKORDB_GRAPH=helio

# ---------------------------------------------------------------------------
# SaaS layer (accounts, quotas, billing)
#
# The commercial state (accounts, users, sessions, API keys, usage,
# subscriptions) lives in one SQLite file. It is separate from FalkorDB, which
# still holds the company graph.
#
# IMPORTANT: SQLite is a single-writer database. Run ONE API replica with this
# file on a persistent volume. For multiple replicas, move app/store.py to
# Postgres first.
# ---------------------------------------------------------------------------

# Where the commercial database lives. In Docker this must be on a volume, or
# every deploy starts with all accounts gone.
HELIO_DB_PATH=data/helio.db

# 1 = every /ask requires a signed-in session or API key.
# 0 (default) = the public demo still works, with a per-IP daily limit.
HELIO_REQUIRE_AUTH=0

# Anonymous questions allowed per IP per day when HELIO_REQUIRE_AUTH=0.
# Set 0 to disable anonymous questions entirely.
ANON_DAILY_LIMIT=100

# 1 = trust X-Forwarded-For for the anonymous IP limit. Only turn this on
# behind a proxy you control (Render, Fly, nginx); otherwise a client can
# rotate the header and bypass the demo limit.
HELIO_TRUST_PROXY=0

# Public origin used for Stripe success/cancel/portal redirects.
# Example: https://helio-brain.onrender.com
HELIO_APP_URL=

# Force the session cookie Secure flag. Leave unset behind TLS so it is
# detected from X-Forwarded-Proto; set 0 for plain-HTTP local development.
# HELIO_COOKIE_SECURE=0

# ---------------------------------------------------------------------------
# Stripe (only needed to sell paid plans)
#
# STRIPE_MODE=local + HELIO_ALLOW_LOCAL_BILLING=1 upgrades an account without
# contacting Stripe. That is a development shortcut ONLY: leaving it on in
# production gives away paid plans. Keep local billing off anywhere public.
# ---------------------------------------------------------------------------
STRIPE_MODE=local
HELIO_ALLOW_LOCAL_BILLING=0

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PROFESSIONAL=

# Legacy alias kept for older deployments. New setups should use
# STRIPE_PRICE_PROFESSIONAL.
STRIPE_PRICE_PRO=

